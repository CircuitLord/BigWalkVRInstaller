<Window x:Class="BigWalkVRInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Big Walk VR Installer"
        Width="720" Height="640" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStyle="None"
        Icon="app.ico"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="ModCard">
            <Border Style="{StaticResource Card}" Padding="16,13">
              <Grid>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                <Border Style="{StaticResource Tag}" Padding="6,1" Margin="8,0,0,0"
                                        Background="{StaticResource AmberFill}" BorderBrush="{StaticResource AmberFillBorder}"
                                        Visibility="{Binding IsBeta, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="BETA" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5"
                                       Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" Margin="0,7,0,0"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <Button Style="{StaticResource QuietDanger}" Content="Uninstall" FontSize="11.5" Padding="6,3"
                                    Margin="0,0,8,0" VerticalAlignment="Center" Click="Uninstall_Click"
                                    Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Primary}" Content="{Binding InstallLabel}" Padding="18,7"
                                    Click="Install_Click"
                                    Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Update}" Content="{Binding UpdateLabel}" Padding="18,7"
                                    Click="Install_Click"
                                    Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVis}}" />
                            <Border Style="{StaticResource StatusChip}"
                                    Visibility="{Binding ShowCurrent, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource Green}" VerticalAlignment="Center"
                                               Margin="0,1,7,0" />
                                    <TextBlock Text="Installed" Foreground="{StaticResource Green}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,12,0,2"
                                Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BusyText}" FontSize="11.5"
                                   Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />
                        <ProgressBar Style="{StaticResource Progress}" Value="{Binding Progress}" />
                    </StackPanel>
                </StackPanel>

                <!-- corner badge marking a mod with a pending update -->
                <Border Width="21" Height="21" CornerRadius="11" Background="{StaticResource Amber}"
                        BorderBrush="{StaticResource Bg}" BorderThickness="2"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-24,0"
                        ToolTip="{Binding UpdateLabel}"
                        Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Bg}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- titlebar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="app.ico" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Big Walk VR Installer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="10,1,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Button Style="{StaticResource TitlebarButton}" Click="Minimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource TitlebarClose}" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- nav -->
        <Grid Grid.Row="1" Margin="18,4,18,12">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NavInstall" Style="{StaticResource NavPill}" Content="Install"
                                 IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavLogs" Style="{StaticResource NavPill}" Content="Logs" Margin="3,0,0,0"
                                 Checked="Nav_Checked" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Ghost}" Content="Refresh" Click="Refresh_Click" />
                <Button x:Name="LaunchNonVrButton" Style="{StaticResource Secondary}" Content="Launch in Non-VR"
                        Padding="18,7" Margin="8,0,0,0" Click="LaunchNonVr_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Play normally while seeing VR players' tracked movement" />
                <Button x:Name="LaunchButton" Style="{StaticResource Primary}" Content="Launch in VR"
                        Padding="18,7" Margin="8,0,0,0" Click="Launch_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Launch Big Walk in VR, start SteamVR first" />
            </StackPanel>
        </Grid>

        <!-- installer update banner, only up when a newer build exists -->
        <Border x:Name="SelfUpdateBanner" Grid.Row="2" Style="{StaticResource InfoPanel}" Margin="18,0,18,12"
                Padding="16,12" Background="{StaticResource AmberFill}"
                BorderBrush="{StaticResource AmberFillBorder}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="SelfUpdateTitle" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button x:Name="SelfUpdateButton" Grid.Column="2" Style="{StaticResource Update}"
                        Content="Update now" Padding="18,7" VerticalAlignment="Center" Click="SelfUpdate_Click" />
            </Grid>
        </Border>

        <!-- content -->
        <Grid Grid.Row="3" Margin="18,0,18,0">

            <!-- viewport runs 10px wider than the cards so corner badges are not clipped -->
            <ScrollViewer x:Name="InstallView" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0">
                <StackPanel Margin="0,0,10,0">

                    <!-- step 1, game folder -->
                    <Border Style="{StaticResource CardStatic}" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GameBadge" Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource Hover}" BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1" VerticalAlignment="Center" Margin="0,0,13,0">
                                <TextBlock x:Name="GameBadgeText" Text="1" Tag="1" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Find Big Walk" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="GamePathText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OpenFolderButton" Style="{StaticResource Ghost}" Content="Open"
                                        Padding="14,7" Click="OpenGameFolder_Click" />
                                <Button x:Name="ChangeFolderButton" Style="{StaticResource Ghost}" Content="Change"
                                        Padding="14,7" Margin="8,0,0,0" Click="ChangeGamePath_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- step 2, BepInEx, gates everything below -->
                    <Border Style="{StaticResource CardStatic}" Padding="16,13">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BepInExBadge" Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                        Background="{StaticResource Hover}" BorderBrush="{StaticResource Stroke}"
                                        BorderThickness="1" VerticalAlignment="Center" Margin="0,0,13,0">
                                    <TextBlock x:Name="BepInExBadgeText" Text="2" Tag="2" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDim}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="Set up BepInEx" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BepInExText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button x:Name="BepInExButton" Grid.Column="2" Style="{StaticResource Primary}" Padding="18,7"
                                        VerticalAlignment="Center" Click="InstallBepInEx_Click" />
                            </Grid>
                            <StackPanel x:Name="BepInExProgressPanel" Margin="0,12,0,2" Visibility="Collapsed">
                                <TextBlock x:Name="BepInExProgressText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                           Margin="0,0,0,6" />
                                <ProgressBar x:Name="BepInExProgress" Style="{StaticResource Progress}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- step 3, the mods themselves -->
                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border x:Name="ModsBadge" Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource Hover}" BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1" VerticalAlignment="Center" Margin="0,0,13,0">
                                <TextBlock x:Name="ModsBadgeText" Text="3" Tag="3" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Install mods" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox x:Name="BetaUpdatesToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="BetaUpdates_Click">
                            <TextBlock Text="Beta updates (Unstable)" FontSize="11.5"
                                       Foreground="{StaticResource TextDim}" />
                        </CheckBox>
                    </Grid>

                    <StackPanel x:Name="ModsSection">
                        <ItemsControl x:Name="CoreList" ItemTemplate="{StaticResource ModCard}" />

                        <StackPanel x:Name="OptionalSection" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="OPTIONAL ADD-ONS" FontSize="10.5" FontWeight="SemiBold" Opacity="0.8"
                                       Foreground="{StaticResource TextDim}" Margin="2,0,0,8" />
                            <ItemsControl x:Name="OptionalList" ItemTemplate="{StaticResource ModCard}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="OfflineNotice" Text="Couldn't reach the download list. Check your connection and press Refresh."
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,20,0,0"
                               Visibility="Collapsed" />

                    <!-- footer help -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,22,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource Quiet}" Content="Discord" FontSize="11.5" Padding="6,3"
                                    Click="OpenDiscord_Click" />
                            <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                            <Button Style="{StaticResource Quiet}" Content="GitHub" FontSize="11.5" Padding="6,3"
                                    Click="OpenRepo_Click" />
                            <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                            <Button Style="{StaticResource Quiet}" Content="Mod logs" FontSize="11.5" Padding="6,3"
                                    Click="OpenModLogs_Click" ToolTip="BepInEx\LogOutput.log in the game folder" />
                            <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                            <Button x:Name="CrashReportButton" Style="{StaticResource Quiet}" Content="Create crash report"
                                    FontSize="11.5" Padding="6,3" Click="CreateCrashReport_Click"
                                    ToolTip="Package the BepInEx and Unity logs for Discord" />
                            <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                            <Button x:Name="RestoreVanillaButton" Style="{StaticResource QuietDanger}" Content="Restore vanilla"
                                    FontSize="11.5" Padding="6,3" Click="RestoreVanilla_Click"
                                    ToolTip="Remove every installed BepInEx mod and return to a clean game" />
                        </StackPanel>
                        <TextBlock Text="Made for the love of VR by CircuitLord" FontSize="11.5" FontStyle="Italic"
                                   Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,26,0,5" />
                        <Button Style="{StaticResource SupportButton}" HorizontalAlignment="Center" Click="OpenSupport_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♥" Margin="0,0,7,0" />
                                <TextBlock Text="Support" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="LogsView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="LogsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Time}" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                           FontFamily="Consolas" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- bottom bar -->
        <Grid Grid.Row="4" Margin="18,12,18,14">
            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,10,0" />
        </Grid>

        <!-- launch progress, explains the one-time il2cpp regen when it happens -->
        <Border x:Name="LaunchOverlay" Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource Scrim}" Visibility="Collapsed">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Control Grid.Column="0" Style="{StaticResource Spinner}" VerticalAlignment="Center"
                                 Margin="0,0,15,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LaunchTitle" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="LaunchDescription" FontSize="12" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="GenPanel" Style="{StaticResource InfoPanel}" Margin="0,16,0,0" Padding="14,12"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GenCheck" Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{StaticResource Green}" VerticalAlignment="Center"
                                       Margin="0,0,11,0" Visibility="Collapsed" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="GenTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="GenText" FontSize="12" Foreground="{StaticResource TextDim}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource Ghost}" Content="Stop" Padding="16,7" Margin="0,18,0,0"
                            HorizontalAlignment="Right" Click="LaunchStop_Click" />
                </StackPanel>
            </Border>
        </Border>

        <!-- themed confirm, replaces the system message box -->
        <Border x:Name="ConfirmOverlay" Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource Scrim}" Visibility="Collapsed">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Width="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConfirmText" FontSize="12.5" Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap" Margin="0,7,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource Ghost}" Content="Cancel" Padding="16,7" Click="ConfirmCancel_Click" />
                        <Button x:Name="ConfirmOk" Style="{StaticResource Danger}" Padding="16,7" Margin="8,0,0,0"
                                Click="ConfirmOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
