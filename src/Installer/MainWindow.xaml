<Window x:Class="BigWalkVRInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Big Walk VR Installer"
        Width="720" Height="640" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        WindowStyle="None"
        Icon="app.ico"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="ModCard">
            <Border Style="{StaticResource Card}" Padding="16,13">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5"
                                       Foreground="{StaticResource TextDim}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" Margin="0,7,0,0"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Primary}" Content="Install" Padding="18,7"
                                    Click="Install_Click"
                                    Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Primary}" Content="{Binding UpdateLabel}" Padding="18,7"
                                    Click="Install_Click"
                                    Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        Visibility="{Binding ShowCurrent, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Green}"
                                         VerticalAlignment="Center" Margin="0,1,7,0" />
                                <TextBlock Text="Installed" Foreground="{StaticResource Green}" FontSize="12.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource Quiet}" Content="Uninstall" FontSize="11" Padding="6,3"
                                    Margin="0,6,0,0" HorizontalAlignment="Right" Click="Uninstall_Click"
                                    Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,12,0,2"
                                Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BusyText}" FontSize="11.5"
                                   Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />
                        <ProgressBar Style="{StaticResource Progress}" Value="{Binding Progress}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- titlebar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="app.ico" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Big Walk VR Installer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="10,1,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Button Style="{StaticResource TitlebarButton}" Click="Minimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource TitlebarClose}" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- nav -->
        <Grid Grid.Row="1" Margin="18,4,18,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NavInstall" Style="{StaticResource NavPill}" Content="Install"
                             IsChecked="True" Checked="Nav_Checked" />
                <RadioButton x:Name="NavLogs" Style="{StaticResource NavPill}" Content="Logs" Margin="6,0,0,0"
                             Checked="Nav_Checked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaunchButton" Style="{StaticResource Primary}" Content="Launch in VR"
                        Padding="18,7" Click="Launch_Click" ToolTip="Start SteamVR first, then launch" />
                <Button Style="{StaticResource Ghost}" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <!-- content -->
        <Grid Grid.Row="2" Margin="18,0,18,0">

            <ScrollViewer x:Name="InstallView" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- step 1, game folder -->
                    <Border Style="{StaticResource CardStatic}" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GameBadge" Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource Hover}" BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1" VerticalAlignment="Center" Margin="0,0,13,0">
                                <TextBlock x:Name="GameBadgeText" Text="1" Tag="1" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Find Big Walk" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="GamePathText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OpenFolderButton" Style="{StaticResource Ghost}" Content="Open"
                                        Padding="14,7" Click="OpenGameFolder_Click" />
                                <Button x:Name="ChangeFolderButton" Style="{StaticResource Ghost}" Content="Change"
                                        Padding="14,7" Margin="8,0,0,0" Click="ChangeGamePath_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- step 2, melonloader, gates everything below -->
                    <Border Style="{StaticResource CardStatic}" Padding="16,13">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="MelonBadge" Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                        Background="{StaticResource Hover}" BorderBrush="{StaticResource Stroke}"
                                        BorderThickness="1" VerticalAlignment="Center" Margin="0,0,13,0">
                                    <TextBlock x:Name="MelonBadgeText" Text="2" Tag="2" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextDim}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="Set up MelonLoader" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MelonText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button x:Name="MelonButton" Grid.Column="2" Style="{StaticResource Primary}" Padding="18,7"
                                        VerticalAlignment="Center" Click="InstallMelon_Click" />
                            </Grid>
                            <StackPanel x:Name="MelonProgressPanel" Margin="0,12,0,2" Visibility="Collapsed">
                                <TextBlock x:Name="MelonProgressText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                           Margin="0,0,0,6" />
                                <ProgressBar x:Name="MelonProgress" Style="{StaticResource Progress}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- step 3, the mods themselves -->
                    <Grid Margin="0,10,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ModsBadge" Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource Hover}" BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1" VerticalAlignment="Center" Margin="0,0,13,0">
                                <TextBlock x:Name="ModsBadgeText" Text="3" Tag="3" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Install the mod" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ModsLocked" Style="{StaticResource CardStatic}" Padding="16,16" Visibility="Collapsed">
                        <TextBlock x:Name="ModsLockedText" FontSize="12.5" Foreground="{StaticResource TextDim}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel x:Name="ModsSection">
                        <ItemsControl x:Name="CoreList" ItemTemplate="{StaticResource ModCard}" />

                        <StackPanel x:Name="OptionalSection" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="OPTIONAL ADD-ONS" FontSize="10.5" FontWeight="SemiBold" Opacity="0.8"
                                       Foreground="{StaticResource TextDim}" Margin="2,0,0,8" />
                            <ItemsControl x:Name="OptionalList" ItemTemplate="{StaticResource ModCard}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="OfflineNotice" Text="Couldn't reach the download list. Check your connection and press Refresh."
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,20,0,0"
                               Visibility="Collapsed" />

                    <!-- footer help -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,10">
                        <TextBlock Text="Start SteamVR, then press Launch in VR." FontSize="11.5"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Style="{StaticResource Quiet}" Content="GitHub" FontSize="11.5" Padding="6,3"
                                Click="OpenRepo_Click" />
                        <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                        <Button Style="{StaticResource Quiet}" Content="Mod logs" FontSize="11.5" Padding="6,3"
                                Click="OpenModLogs_Click" ToolTip="MelonLoader\Latest.log in the game folder" />
                        <TextBlock Text="•" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="4,0" />
                        <Button x:Name="RestoreVanillaButton" Style="{StaticResource Quiet}" Content="Restore vanilla"
                                FontSize="11.5" Padding="6,3" Click="RestoreVanilla_Click"
                                ToolTip="Remove every mod and MelonLoader, back to a clean game" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="LogsView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="LogsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Time}" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                           FontFamily="Consolas" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- bottom bar -->
        <Grid Grid.Row="3" Margin="18,12,18,14">
            <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,10,0" />
            <Button x:Name="SelfUpdateButton" Style="{StaticResource Primary}" HorizontalAlignment="Right"
                    Visibility="Collapsed" Click="SelfUpdate_Click" />
        </Grid>

        <!-- themed confirm, replaces the system message box -->
        <Border x:Name="ConfirmOverlay" Grid.Row="0" Grid.RowSpan="4" Background="#D914171C" Visibility="Collapsed">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Width="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" FontSize="14.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConfirmText" FontSize="12.5" Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap" Margin="0,7,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource Ghost}" Content="Cancel" Padding="16,7" Click="ConfirmCancel_Click" />
                        <Button x:Name="ConfirmOk" Style="{StaticResource Danger}" Padding="16,7" Margin="8,0,0,0"
                                Click="ConfirmOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
